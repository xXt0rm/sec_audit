# Shannon — configuración de credenciales (BYOK).
# Copia a `.env` dentro del repo de Shannon y pon TU clave. No lo subas a git.
# SHANNON_AI_MODEL es <provider>:<model-id>.

# --- Anthropic (ejemplo) ---
SHANNON_AI_API_KEY=tu-clave-aqui
SHANNON_AI_MODEL=anthropic:claude-sonnet-4-6

# --- OpenAI ---
# SHANNON_AI_API_KEY=tu-clave-aqui
# SHANNON_AI_MODEL=openai:gpt-6-sol

# --- xAI ---
# SHANNON_AI_API_KEY=tu-clave-aqui
# SHANNON_AI_MODEL=xai:grok-4.7

# --- AWS Bedrock (solo bearer token; modelo habilitado en tu región) ---
# AWS_REGION=us-east-1
# AWS_BEARER_TOKEN_BEDROCK=tu-bearer-token
# SHANNON_AI_MODEL=amazon-bedrock:us.anthropic.claude-opus-4-8

# Recuerda: completa la verificación de ciberseguridad de tu proveedor antes del primer escaneo.
